# Copy to .env.local for cloud development. Keep keys out of Git.
CONVEX_DEPLOYMENT=dev:stoic-gerbil-925
# CONVEX_DEPLOY_KEY=<development deploy key; never NEXT_PUBLIC>
NEXT_PUBLIC_CONVEX_URL=https://stoic-gerbil-925.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://stoic-gerbil-925.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set the following on the Convex deployment, NOT as NEXT_PUBLIC variables.
# bunx --bun convex env set NAME (paste secret via stdin)
# SITE_URL=https://your-store.example
# JWT_PRIVATE_KEY=<generated RSA private key>
# JWKS=<matching public JWK set>
# CHAPA_SECRET_KEY=<merchant test secret>
# CHAPA_WEBHOOK_SECRET=<same nonempty secret hash as the Chapa dashboard; prefer a long random value>
# CHAPA_MODE=test
# SUPPLIER_FEED_URL=https://your-adapter.example/products
# SUPPLIER_API_KEY=<supplier token>
# EXCHANGE_FEED_URL=https://your-adapter.example/rates
# EXCHANGE_API_KEY=<exchange token>

# Password recovery on Convex:
# AUTH_RESEND_KEY=<email provider key>
# AUTH_EMAIL_FROM=EthioSource <support@your-domain.example>

# Optional operator-only admin seeding (never NEXT_PUBLIC; remove password after use):
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Store Administrator
# ADMIN_PASSWORD=<at least 10 characters>
